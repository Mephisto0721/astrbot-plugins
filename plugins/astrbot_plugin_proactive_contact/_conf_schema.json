{
  "deepseek_api_key": {
    "description": "DeepSeek API Key",
    "type": "string",
    "default": ""
  },
  "deepseek_base_url": {
    "description": "API Base URL",
    "type": "string",
    "default": "https://api.deepseek.com/v1"
  },
  "deepseek_model": {
    "description": "唤醒判断用的模型",
    "type": "string",
    "default": "deepseek-chat"
  },
  "chain_default_interval_minutes": {
    "description": "链式 Timer 初始间隔（分钟）",
    "type": "int",
    "default": 120
  },
  "chain_min_interval_minutes": {
    "description": "链式 Timer 最小间隔（分钟）",
    "type": "int",
    "default": 15
  },
  "chain_max_interval_minutes": {
    "description": "链式 Timer 最大间隔（分钟）",
    "type": "int",
    "default": 720
  },
  "quiet_hours_start": {
    "description": "免打扰开始小时（24 制，0-23）",
    "type": "int",
    "default": 23
  },
  "quiet_hours_end": {
    "description": "免打扰结束小时",
    "type": "int",
    "default": 7
  },
  "history_window": {
    "description": "唤醒时带最近多少条消息",
    "type": "int",
    "default": 20
  }
}